# ── PUBLIC — aman di-expose ke browser (prefix VITE_ wajib) ──────────
# Project API Key dari PostHog → Project Settings > Project API Key
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Host ingest PostHog (dipakai posthog-js buat kirim event) —
# us.i.posthog.com / eu.i.posthog.com / atau self-hosted domain
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Project ID (angka) → Project Settings > Project ID
# Pakai prefix VITE_ juga — project ID bukan data sensitif, dan tetap
# bisa dibaca di server (Vercel inject semua env var ke process.env,
# prefix VITE_ cuma ngatur apakah di-inline ke bundle client atau nggak)
VITE_POSTHOG_PROJECT_ID=12345

# ── PRIVATE — JANGAN pakai prefix VITE_, hanya dipakai di server ─────
# Personal API Key → User Settings > Personal API Keys > Create new
# Butuh permission: "Query Read"
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
